<Application x:Class="CatalogoFilmes.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="Views/DashboardWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Primary" Color="#6D5EF5"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#F4F5FA"/><Setter Property="Foreground" Value="#20243B"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="36"/><Setter Property="MinColumnWidth" Value="80"/><Setter Property="Background" Value="White"/></Style>
 </Application.Resources>
</Application>
