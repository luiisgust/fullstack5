<Window x:Class="CatalogoFilmes.Views.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CineCatálogo" Width="1000" Height="610" MinWidth="850" MinHeight="500" WindowStartupLocation="CenterScreen">
 <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="CineCatálogo" FontSize="34" FontWeight="Bold"/><TextBlock Text="Seu catálogo de filmes, organizado em um só lugar." Foreground="#6F748A" Margin="0,8,0,28"/></StackPanel>
 <UniformGrid Grid.Row="1" Columns="2" Rows="2">
  <Button Tag="Filmes" Click="Abrir_Click" Background="#6D5EF5" Foreground="White" Margin="0,0,14,14"><StackPanel><TextBlock Text="FILMES" FontSize="16"/><TextBlock x:Name="txtFilmes" Text="—" FontSize="46" FontWeight="Bold"/><TextBlock Text="Cadastrar e pesquisar filmes →"/></StackPanel></Button>
  <Button Tag="Generos" Click="Abrir_Click" Background="#087F8C" Foreground="White" Margin="0,0,0,14"><StackPanel><TextBlock Text="GÊNEROS" FontSize="16"/><TextBlock x:Name="txtGeneros" Text="—" FontSize="46" FontWeight="Bold"/><TextBlock Text="Organizar categorias →"/></StackPanel></Button>
  <Button Tag="Diretores" Click="Abrir_Click" Background="#AD5A22" Foreground="White" Margin="0,0,14,0"><StackPanel><TextBlock Text="DIRETORES" FontSize="16"/><TextBlock x:Name="txtDiretores" Text="—" FontSize="46" FontWeight="Bold"/><TextBlock Text="Gerenciar diretores →"/></StackPanel></Button>
  <Button Tag="Avaliacoes" Click="Abrir_Click" Background="#B83B70" Foreground="White" Margin="0"><StackPanel><TextBlock Text="AVALIAÇÕES" FontSize="16"/><TextBlock x:Name="txtAvaliacoes" Text="—" FontSize="46" FontWeight="Bold"/><TextBlock Text="Registrar notas e comentários →"/></StackPanel></Button>
 </UniformGrid>
 <DockPanel Grid.Row="2" Margin="0,24,0,0"><Button Content="Atualizar painel" Click="Atualizar_Click" DockPanel.Dock="Right"/><TextBlock x:Name="txtStatus" Text="Conectando ao MySQL…" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>
